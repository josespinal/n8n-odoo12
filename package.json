{
	"name": "n8n-nodes-odoo-tameson",
	"version": "0.1.6",
	"description": "Odoo node for N8N compatible with v13",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://www.industria.com.do",
	"author": {
		"name": "Jose Espinal",
		"email": "contacto@industria.com.do"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/josespinal/n8n-odoo12"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier --write \"nodes/**/*.ts\" \"index.ts\"",
		"lint": "eslint . --ext .ts",
		"lintfix": "eslint . --ext .ts --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/OdooApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Tamesonodoo/Tamesonodoo.node.js"
		]
	},
	"dependencies": {
		"xmlrpc": "^1.3.2"
	},
	"devDependencies": {
		"@types/express": "^4.17.6",
		"@types/node": "^20.10.0",
		"@types/request-promise-native": "~1.0.15",
		"@types/xmlrpc": "^1.3.7",
		"@typescript-eslint/eslint-plugin": "^8.49.0",
		"@typescript-eslint/parser": "^8.49.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.11.0",
		"gulp": "^4.0.2",
		"n8n-core": "*",
		"n8n-workflow": "*",
		"prettier": "^2.7.1",
		"typescript": "5.4.5"
	}
}
